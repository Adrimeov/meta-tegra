[Unit]
Description=Unload the fTPM driver before tee-supplicant stops
# TPM2_Shutdown on unbind is the last NV write the fTPM gets.
After=tee-supplicant.service
BindsTo=tee-supplicant.service

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/bin/true
ExecStop=modprobe -r tpm_ftpm_tee

[Install]
WantedBy=tee-supplicant.service
